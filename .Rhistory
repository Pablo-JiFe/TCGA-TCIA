surv_obj <- Surv(train_surv$time, train_surv$event)
train_surv_for_cox <- train_surv %>%
dplyr::select(-c(time, event))
summary(coxph(surv_obj~., train_surv_for_cox))
library(dplyr)
library(survival)
train_latent <- read.csv("output_data/latent_train.csv", row.names = 1)
test_latent <- read.csv("output_data/latent_test.csv", row.names = 1)
refined_data <- readRDS("./data/metadata_tcga.RDS")
metadata <-
refined_data %>%
filter(substr(start = 14, stop = 15, x = sampleID) == "01") # Filter only the registry of the sample corresponding to primary
metadata_test <- metadata[metadata$sampleID %in% substr(start = 1, stop = 15, x = rownames(test_latent)),]
z <- lapply(seq_along(rownames(test_latent)), function(i){
x <- test_latent[i, ]
metadata_temp <- metadata_test[metadata_test$sampleID %in% substr(start = 1, stop = 15, x = rownames(x)), ]
x$event <- metadata_temp$SURVIVAL
x$time <- metadata_temp$SURVIVAL_MON
return(x)
})
test_surv <- as.data.frame(do.call(rbind, z))
surv_obj <- Surv(test_surv$time, test_surv$event)
test_surv_for_cox <- test_surv %>%
dplyr::select(-c(time, event))
cox_test <- coxph(surv_obj~., test_surv_for_cox)
summary(cox_test)
cox.zph(cox_test)
metadata_train <- metadata[metadata$sampleID %in% substr(start = 1, stop = 15, x = rownames(train_latent)),]
z_train <- lapply(seq_along(rownames(train_latent)), function(i){
x <- train_latent[i, ]
metadata_temp <- metadata_train[metadata_train$sampleID %in% substr(start = 1, stop = 15, x = rownames(x)), ]
x$event <- metadata_temp$SURVIVAL
x$time <- metadata_temp$SURVIVAL_MON
return(x)
})
train_surv <- as.data.frame(do.call(rbind, z_train))
surv_obj <- Surv(train_surv$time, train_surv$event)
train_surv_for_cox <- train_surv %>%
dplyr::select(-c(time, event))
summary(coxph(surv_obj~., train_surv_for_cox))
